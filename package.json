{
  "name": "destiny2-mcp",
  "engines": {"node": ">=24.0.0"},
  "version": "1.0.0",
  "description": "An MCP server for destiny 2 inventory management",
  "license": "ISC",
  "author": "Kuba Kuchniak",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "node --test --env-file=.env.test --import ./src/tests/setup.mjs",
    "start": "node --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "rm -rf build && npm run build && cp manifest.json package.json package-lock.json build/ && npm ci --omit=dev --prefix build && npx @anthropic-ai/mcpb pack build destiny2-mcp.mcpb"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "selfsigned": "^5.5.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  }
}
